# ═══════════════════════════════════════════════════════════════════════════
# TracyHill RP: example environment file
# ═══════════════════════════════════════════════════════════════════════════
#
# Every line is optional: `docker compose up -d` works without a .env file.
#   1. docker compose up -d
#   2. docker compose logs tracyhill-rp | grep -A 2 "setup code"
#   3. Open http://localhost:3000, enter the code, create your administrator
#      account and connect a model provider
#
# The first start creates this deployment's own random session secret
# (data/v2/session.secret); there is nothing to generate.
#
# To change a setting, copy this file to .env, uncomment the lines you need,
# edit them and run `docker compose up -d` again. Each commented value is the
# default or an example. Email, sign-up, two-factor, the daily sign-out and
# server-wide provider keys are easier to set in the app (Admin: Server
# settings); a value set in this file wins and shows locked there.
#
# The API and the worker read every line of .env, including variables that
# docker-compose.yml does not name. The subscription runner reads only the
# variables docker-compose.yml lists for it.
#
# ENVIRONMENT.md explains every variable.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core runtime ────────────────────────────────────────────────────────────

# The deployment's root secret. Leave it unset: the first start generates a
# random one and stores it in data/v2/session.secret. It signs the session
# cookies and is the key for every stored secret (provider and custom-endpoint
# keys, authenticator apps, Server settings secrets) and for the runner's
# secret, so changing it signs everyone out and makes those unreadable. Set it
# only to carry over an existing deployment's secret, and set it here: the
# worker does not receive a value exported only in the shell. Never commit a
# real value to version control.
# SESSION_SECRET=

# Port the API listens on inside its container.
# PORT=3000

# Port published on the Docker host. 127.0.0.1:3000 publishes it on the
# loopback interface only, for a reverse proxy on the same machine.
# HOST_PORT=3000

# SQLite database inside the container. Keep it under /app/data, the
# bind-mounted ./data folder, so it survives a rebuild.
# DB_FILE=/app/data/v2/tracyhill-rp-v2.sqlite

# Generated images, also under ./data.
# IMAGE_DIR=/app/data/v2/images

# The built web app the API serves.
# WEB_DIST_DIR=/app/apps/web/dist

# Keep 0 with this Compose file: the dedicated worker container runs the
# background jobs, and running them in the API as well (1) makes the two
# requeue each other's running jobs.
# INLINE_WORKERS=0

# How often the worker checks for queued jobs, in milliseconds (minimum 50).
# PIPELINE_POLL_MS=1000

# Per-turn retrieval scoring on a worker thread of the API (0: the API's main
# thread, same results).
# CONTEXT_SCORING_WORKER=1

# Start a campaign turn's antagonist-intent and contested-action calls
# alongside context assembly (0: one after the other).
# CHAT_PRECOMPOSER_OVERLAP=1

# Deployment-wide default chat model (a catalog chat-model id) for new
# sessions, the campaign wizard and every automated worker fallback. Explicit
# choices win and embedding models are unaffected. An invalid id is ignored
# and reported at start.
# DEFAULT_MODEL_ID=claude-sonnet-4-6

# Time zone a new server's daily sign-out falls back to when the browser that
# ran first-run setup reported none (default UTC). After setup it is a Server
# setting.
# TZ=Europe/Berlin

# Set when a reverse proxy that provides HTTPS sits in front of the app: 1 or
# true for one proxy, a larger number for a chain of proxies, or a list of
# trusted addresses. It also marks the session cookie Secure, so leave it off
# when browsers connect to the app directly over plain HTTP.
# TRUST_PROXY=false

# Exact IP addresses allowed to connect to the API, normally your reverse
# proxy's (no CIDR ranges); * allows every address. The check uses the TCP
# peer of each connection; X-Forwarded-For plays no part. IPv4-mapped IPv6
# peers match their IPv4 entry, and the container's own loopback always
# passes. Example: ALLOWED_IPS=192.0.2.10
# ALLOWED_IPS=*

# Host names whose custom endpoints (Options → Providers → Custom Endpoints)
# may resolve to private addresses, for a server on your own network such as
# LM Studio or Ollama. Custom endpoints must use https:// either way, so such
# a server needs a certificate the API trusts.
# CUSTOM_ENDPOINT_ALLOW_HOSTS=lmstudio.local,ollama.lan

# Log verbosity: trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL=info

# Container log rotation (json-file driver), for every service.
# DOCKER_LOG_MAX_SIZE=10m
# DOCKER_LOG_MAX_FILE=5

# ── Chat providers ──────────────────────────────────────────────────────────
# Every key is optional. An account's own key (Options → Providers) wins;
# otherwise accounts use the server's key: the value set here, or the shared
# key saved in Admin: Server settings → Shared keys. A key set here locks that
# provider's shared key on the page. Every account without a key of its own
# can use a server key, and the provider charges that use to the key's owner.

# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# FIREWORKS_API_KEY=
# GMICLOUD_API_KEY=
# GOOGLE_API_KEY=
# MOONSHOT_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# XIAOMI_API_KEY=
# ZAI_API_KEY=

# ── Local embeddings (optional) ─────────────────────────────────────────────
# An OpenAI-compatible embeddings server of your own (Text Embeddings
# Inference, Ollama, LM Studio, vLLM) for the local:nomic-embed-text-v1.5 and
# local:bge-m3 models. It must answer to the model name after "local:". While
# the URL is unset the local models are unavailable; the key is optional.

# LOCAL_EMBEDDING_URL=http://embeddings.lan:11434/v1
# LOCAL_EMBEDDING_KEY=

# ── Subscription runner (built in, nothing to set) ──────────────────────────
# The tracyhill-rp-runner service lets each account sign in to its own Claude
# or ChatGPT subscription (Options → Providers → Subscriptions) for the -bridge
# and -codex-bridge models. The API and the worker reach it by its Compose
# service name, and its secret is derived from the session secret. Set these
# only for a runner on another host (RUNNER_URL, plus the same RUNNER_SECRET
# for the API, the worker and the runner) or to change its memory cap. The
# runner's own variables (RUNNER_CODEX_IDLE_MS and others) are not read from
# this file; ENVIRONMENT.md shows how to set them.

# RUNNER_URL=http://tracyhill-rp-runner:7710
# RUNNER_SECRET=
# RUNNER_MEMORY_LIMIT=3g

# ── Email ───────────────────────────────────────────────────────────────────
# Easiest in the app: Admin: Server settings → Email (SendGrid or SMTP, with a
# test email). Email is needed for sign-up, forgot-password, email sign-in
# codes, deleting one's own account and changing an email address; without it
# an administrator creates accounts and resets passwords in Admin: Users.
# These variables are the alternative. SENDGRID_API_KEY wins over the page and
# locks its email fields; EMAIL_FROM and EMAIL_FROM_NAME lock the sender. Use
# a sender address your SendGrid account has verified.

# SENDGRID_API_KEY=
# EMAIL_FROM=rp@example.org
# EMAIL_FROM_NAME=TracyHill RP

# ── Coding panels (optional, administrators only) ───────────────────────────
# Full-screen Claude Code, Codex and Kimi (K3) workspaces in the Coding menu,
# each driving an agent service that runs outside this app, reached over HTTPS
# with a shared secret. None is set up automatically: a panel turns on when its
# host and secret are set. The Codex panel's service ships in
# tools/codex-agent-service; the Claude Code and Kimi panels need an agent
# service that is not part of this repository. The CA paths are read inside
# the API container, relative to /app; the image has no certs folder, so mount
# ./certs with a docker-compose.override.yml. ENVIRONMENT.md section 7 is the
# setup guide.

# Claude Code panel
# CLAUDE_CODE_HOST=
# CLAUDE_CODE_PORT=7702
# CLAUDE_CODE_SECRET=
# CLAUDE_CODE_CA_PATH=certs/claude-code-panel.pem
# CLAUDE_CODE_SERVERNAME=claude-agent

# Codex panel: the sidecar's address, its AGENT_PORT and AGENT_SECRET, and its
# certificate.
# CODEX_HOST=
# CODEX_PORT=7701
# CODEX_SECRET=
# CODEX_CA_PATH=certs/codex-panel.pem
# CODEX_SERVERNAME=codex-agent
# How many newest turns the panel loads per session, and per subagent thread.
# CODEX_TURN_LIMIT=40
# CODEX_DESCENDANT_TURN_LIMIT=4

# Kimi (K3) panel: an agent service speaking the Claude Code panel's protocol
# with Kimi K3.
# KIMI_CODE_HOST=
# KIMI_CODE_PORT=7704
# KIMI_CODE_SECRET=
# KIMI_CODE_CA_PATH=certs/kimi-panel.pem
# KIMI_CODE_SERVERNAME=kimi-agent

# ── Development only ────────────────────────────────────────────────────────
# A new deployment starts with first-run setup: the server prints a one-time
# code in its log, and whoever enters it creates the first administrator.
# SEED_DEMO_USER=1 skips that on an empty database and creates an
# administrator from DEMO_USERNAME / DEMO_PASSWORD instead. Those credentials
# are well known: never use this on a server others can reach. Turning it off
# later leaves that account in place, still an administrator.

# SEED_DEMO_USER=0
# DEMO_USERNAME=demo
# DEMO_PASSWORD=demo-pass

# 1: mock runtimes for chat, images, pipeline jobs and the wizard, for fixture
# tests and interface work. Embeddings, email, the coding panels and
# subscription sign-ins still use their real services.
# MOCK_PROVIDER=0

# 1: verification codes are also returned in API responses, and the features
# that need email work without it. Local development only: the API refuses to
# start with it under NODE_ENV=production, which docker-compose.yml sets.
# EXPOSE_AUTH_CODES=0
