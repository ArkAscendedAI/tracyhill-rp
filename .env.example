# ═══════════════════════════════════════════════════════════════════════════
# TracyHill RP — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
#
# QUICK START:
#   1. Copy this file to .env:       cp .env.example .env
#   2. Set SESSION_SECRET (below) to a random string:
#                                    openssl rand -hex 32
#   3. docker compose up -d
#   4. Open http://localhost:3000 and log in with: demo / demo-pass
#
# For a detailed explanation of every variable, see ENVIRONMENT.md.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core Runtime ────────────────────────────────────────────────────────────

# REQUIRED. Secret used to sign session cookies. Must be set before the app
# will start. Generate with: openssl rand -hex 32
# Never commit a real value to version control.
SESSION_SECRET=

# Port the API listens on inside the container.
PORT=3000

# Port exposed on the Docker host. Change if 3000 is in use.
HOST_PORT=3000

# SQLite database file path inside the container. Persisted via the ./data
# bind mount in docker-compose.yml.
DB_FILE=/app/data/v2/tracyhill-rp-v2.sqlite

# Directory for generated/uploaded images, also persisted under ./data.
IMAGE_DIR=/app/data/v2/images

# Path to the built web app served by the API. Leave as default unless you're
# customizing the build output location.
WEB_DIST_DIR=/app/apps/web/dist

# Run background workers (pipeline, wizard) inside the API process instead of
# a separate container. Set to 1 for small deployments; leave 0 to use the
# dedicated worker service in docker-compose.yml.
INLINE_WORKERS=0

# Interval in milliseconds for the worker to poll the pipeline queue.
PIPELINE_POLL_MS=1000

# Set to true when the API sits behind a reverse proxy (nginx, Caddy,
# Traefik, Cloudflare) so it correctly reads X-Forwarded-For headers.
TRUST_PROXY=false

# IP allowlist for API access. "*" allows any source. Comma-separate specific
# IPs or CIDRs for lockdown. This gates the upstream TCP peer, not end-user
# IPs, so it's the right place to restrict which reverse-proxy hosts can
# reach the API.
ALLOWED_IPS=*

# Comma-separated allowlist of hostnames that bypass the SSRF private-IP
# gate when users configure a Custom Endpoint baseUrl. By default every
# custom-endpoint baseUrl must resolve to a public IP; set this to opt-in
# specific LAN hosts (e.g. a local LM Studio or Ollama). Leave blank to
# block all private/loopback custom endpoints.
# CUSTOM_ENDPOINT_ALLOW_HOSTS=lmstudio.local,ollama.lan

# Structured log verbosity. One of: trace | debug | info | warn | error
LOG_LEVEL=info

# Docker log rotation (json-file driver). See the `logging` section in
# docker-compose.yml.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# ── Chat Providers ──────────────────────────────────────────────────────────
# All provider keys are optional server-level fallbacks. Users can override
# any of them from the in-app Settings → Provider Keys dialog (their key is
# stored per-user in the database and takes precedence over the env value).
#
# Leave every key blank to run in "bring your own key" mode — users must
# enter their own key on first use. Fill one in here to skip that step for
# everyone on the instance.

# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# XIAOMI_API_KEY=
# ZAI_API_KEY=

# ── Claude Code Chat-Provider Bridge (optional) ─────────────────────────────
# Enables a synthetic "claude-code" chat provider whose -bridge model variants
# (claude-opus-4-7-bridge, etc.) route through a self-hosted Claude Code SDK
# instance instead of the Anthropic per-token API. If you have a Claude
# subscription you'd rather use for chat, point these variables at a Claude
# Code agent service you host. Leave blank to hide the bridge provider.
# This is a DIFFERENT service from the admin Claude Code bridge below — they
# can run side-by-side or independently.

# CLAUDE_CODE_BRIDGE_URL=
# CLAUDE_CODE_BRIDGE_SECRET=

# ── Email (SendGrid) ────────────────────────────────────────────────────────
# Required for registration verification, forgot-password codes, and MFA.
# If left blank, registration/MFA/password-reset flows will fail. Single-user
# installs can skip this by enabling SEED_DEMO_USER below and never using
# the self-service flows.

# SENDGRID_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=TracyHill RP

# ── Claude Code Admin Bridge (optional admin feature) ──────────────────────
# Enables the in-app Claude Code admin DIALOG that lets admins drive a remote
# Claude Code agent over HTTPS (shell access, file edits, automation).
# Leave blank to disable the dialog. This is SEPARATE from the chat-provider
# bridge above; both can run side-by-side or independently.
# See https://claude.com/claude-code for the agent-side project.

# CLAUDE_CODE_HOST=
# CLAUDE_CODE_PORT=7700
# CLAUDE_CODE_SECRET=
# CLAUDE_CODE_CA_PATH=certs/claude-agent.pem
# CLAUDE_CODE_SERVERNAME=claude-agent

# ── OpenAI Codex Bridge (optional admin feature) ────────────────────────────
# Enables the in-app Codex dialog that lets admins drive a remote OpenAI
# Codex CLI session over HTTPS. Leave blank to disable.

# CODEX_HOST=
# CODEX_PORT=7701
# CODEX_SECRET=
# CODEX_CA_PATH=certs/codex-agent.pem
# CODEX_SERVERNAME=codex-agent

# ── Development / Out-of-Box Bootstrap ──────────────────────────────────────
# When SEED_DEMO_USER=1, the API creates a default admin account on first
# boot using DEMO_USERNAME / DEMO_PASSWORD. Great for local development and
# first-time setup. TURN THIS OFF IN PRODUCTION before exposing the server
# to the internet, or change the password immediately after first login.

SEED_DEMO_USER=1
DEMO_USERNAME=demo
DEMO_PASSWORD=demo-pass

# Use a deterministic in-memory provider instead of real LLM APIs. Useful
# for running tests and developing UI without burning tokens.
MOCK_PROVIDER=0

# When 1, MFA/registration/forgot-password codes are included in the JSON
# response instead of only emailed. DO NOT enable outside of local dev —
# this leaks secrets over the wire.
EXPOSE_AUTH_CODES=0
