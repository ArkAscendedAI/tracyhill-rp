{
  "name": "tracyhill-rp",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/worker",
    "packages/*",
    "tools/codex-agent-service"
  ],
  "scripts": {
    "start:api": "node --import tsx apps/api/src/index.ts",
    "start:worker": "node --import tsx apps/worker/src/index.ts",
    "build": "npm --workspaces --if-present --include-workspace-root=false run build",
    "typecheck": "npm --workspaces --if-present --include-workspace-root=false run typecheck && npm run typecheck:runner",
    "dev:web": "npm --prefix ./apps/web run dev",
    "dev:api": "npm --prefix ./apps/api run dev",
    "dev:worker": "npm --prefix ./apps/worker run dev",
    "typecheck:runner": "npm --prefix apps/runner run typecheck",
    "start:runner": "node apps/runner/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "compression": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "pino": "^9.7.0",
    "tsx": "^4.20.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.0.15",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.1.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.4",
    "@tanstack/react-query": "^5.83.0"
  }
}
